{
  "CallerReference": "applyflow-frontend-20260923",
  "Comment": "ApplyFlow React SPA (S3 + CloudFront default cert)",
  "Enabled": true,
  "DefaultRootObject": "index.html",
  "HttpVersion": "http2",
  "PriceClass": "PriceClass_200",
  "Origins": {
    "Quantity": 1,
    "Items": [
      {
        "Id": "applyflow-frontend-s3",
        "DomainName": "applyflow-frontend.s3.ap-south-2.amazonaws.com",
        "OriginAccessControlId": "EJLXCQZMVA0K4",
        "S3OriginConfig": {
          "OriginAccessIdentity": ""
        }
      }
    ]
  },
  "DefaultCacheBehavior": {
